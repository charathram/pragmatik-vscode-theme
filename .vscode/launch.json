{
  // Press Ctrl+F5 (Run Without Debugging) to open an Extension Development
  // Host with the Pragmatik theme loaded and the samples/ folder open. F5 also
  // works, but in VS Code 1.142 the debugger can crash the new window. In that
  // window: Cmd+K Cmd+T to pick a variant. Editing a themes/*.json file
  // hot-reloads the colors live.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pragmatik theme",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/samples"
      ]
    }
  ]
}
